{
  "name": "clockify-for-linear",
  "version": "0.0.2",
  "private": true,
  "description": "Track Linear issues with Clockify from a small browser extension.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e:chromium": "E2E_BROWSER=chromium node --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:e2e:firefox": "E2E_BROWSER=firefox node --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:e2e": "npm run build && npm run test:e2e:chromium && npm run test:e2e:firefox",
    "package": "npm run build && node scripts/package.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^22.16.5",
    "esbuild": "^0.21.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.8.3"
  }
}
