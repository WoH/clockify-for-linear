{
  "name": "Clockify Tracker for Linear",
  "description": "Display time tracking UI in Linear issues using Clockify",
  "version": "1.0.0",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "clockify-for-linear@and-solution.de",
      "strict_min_version": "109.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://linear.app/*"],
      "js": ["src/content-loader.ts"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://linear.app/*",
    "https://api.clockify.me/*",
    "https://app.clockify.me/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.html", "assets/*"],
      "matches": ["https://linear.app/*"]
    }
  ]
}
